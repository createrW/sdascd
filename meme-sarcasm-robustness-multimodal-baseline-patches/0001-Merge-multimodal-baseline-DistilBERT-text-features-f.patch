+++ b/src/text/encoder.py
@@ -0,0 +1,52 @@
+"""Frozen DistilBERT encoder and the sentence vectors we take from it.
+
+Which 768-d vector represents one meme caption?
+
+  first_token   last_hidden_state[:, 0], the final-layer state of the [CLS] token.
+                DistilBERT (Sanh et al., 2019) removed BERT's pooler and token-type embeddings,
+                so there is no `pooler_output`; Hugging Face's DistilBertForSequenceClassification
+                classifies from exactly this vector (then pre_classifier -> ReLU -> classifier).
+                This is the team baseline feature (docs/decisions.md D13).
+  mean_pooling  mean of last_hidden_state over real tokens ([CLS] and [SEP] included,
+                padding excluded via attention_mask). The usual sentence vector for a *frozen*
+                encoder (Sentence-BERT, Reimers & Gurevych, 2019); kept as an ablation.
+"""
+from __future__ import annotations
+
+import torch
+from transformers import AutoModel, AutoTokenizer
+
+TEXT_FEATURES = ("first_token", "mean_pooling")
+
+
+def text_source(cfg: dict, model_dir: str | None = None) -> tuple[str, dict]:
+    """Hub id + pinned revision by default; a local copy of the same weights when offline."""
+    if model_dir:
+        return str(model_dir), {}
+    return cfg["text_model_id"], {"revision": cfg["text_revision"]}
+
+
+def load_text_encoder(cfg: dict, device: torch.device, model_dir: str | None = None):
+    """Tokenizer + frozen DistilBertModel in eval mode (MLM-head weights are not loaded)."""
+    source, kwargs = text_source(cfg, model_dir)
+    tokenizer = AutoTokenizer.from_pretrained(source, **kwargs)
+    model = AutoModel.from_pretrained(source, **kwargs)
+    model.eval().to(device)
+    model.requires_grad_(False)
+    return tokenizer, model
+
+
+def tokenize(tokenizer, texts: list[str], max_length: int) -> dict:
+    """[CLS] text [SEP], WordPiece (uncased), truncated to max_length, padded to the batch maximum."""
+    return tokenizer(texts, padding=True, truncation=True, max_length=max_length,
+                     return_tensors="pt")
+
+
+def pool_text_features(last_hidden_state: torch.Tensor, attention_mask: torch.Tensor,
+                       how: str) -> torch.Tensor:
+    if how == "first_token":
+        return last_hidden_state[:, 0, :]
+    if how == "mean_pooling":
+        mask = attention_mask.unsqueeze(-1).to(last_hidden_state.dtype)
+        return (last_hidden_state * mask).sum(dim=1) / mask.sum(dim=1).clamp(min=1.0)
+    raise ValueError(f"unknown text feature {how!r}; expected one of {TEXT_FEATURES}")
diff --git a/src/text/extract_features.py b/src/text/extract_features.py
new file mode 100644
index 0000000..3d29def
--- /dev/null
+++ b/src/text/extract_features.py
@@ -0,0 +1,162 @@
+"""Run the frozen DistilBERT encoder over every `text_input` ONCE and cache 768-d sentence vectors.
+
+Same idea as src/image/extract_features.py: the encoder is frozen, so a caption's vector never
+changes, and the fusion MLP can then be trained in seconds on CPU. One pass writes both pooled
+vectors described in src/text/encoder.py into two caches:
+
+    <out_prefix>_first_token/<split>.pt    [CLS] state      (baseline, decisions D13)
+    <out_prefix>_mean_pooling/<split>.pt   masked mean      (ablation)
+        -> {"sample_id": list[str], "features": FloatTensor[N, 768], "labels": LongTensor[N]}
+    <out_prefix>_<feature>/meta.json       model revision, tokenizer settings, truncation counts
+
+Tokenization follows README 4.1: the model's own uncased WordPiece tokenizer, [CLS] ... [SEP],
+max length 128 with truncation; `[NO_TEXT]` (shared loader) is encoded like any other caption.
+
+Usage (repo root, MEMOTION_DATA_DIR set):
+    python -m src.text.extract_features                               # train validation test
+    python -m src.text.extract_features --limit 64 --splits validation    # separate smoke cache
+    python -m src.text.extract_features --model_dir hf_local/distilbert-base-uncased   # offline copy
+"""
+import argparse
+import hashlib
+import json
+import sys
+import time
+from pathlib import Path
+
+import torch
+import transformers
+from tqdm import tqdm
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[2]))
+
+from src.common.data import NO_TEXT, SPLITS, load_split  # noqa: E402
+from src.common.reproducibility import get_device, set_seed  # noqa: E402
+from src.image.cache import file_sha256  # noqa: E402
+from src.image.safety import require_new_paths  # noqa: E402
+from src.text.encoder import (TEXT_FEATURES, load_text_encoder, pool_text_features,  # noqa: E402
+                              tokenize)
+
+
+def weights_sha256(model_dir):
+    """Hash of the local weight file, recorded so an offline copy can be traced."""
+    for name in ("model.safetensors", "pytorch_model.bin"):
+        path = Path(model_dir) / name
+        if path.is_file():
+            with path.open("rb") as stream:
+                return name, hashlib.file_digest(stream, "sha256").hexdigest()
+    return None, None
+
+
+@torch.no_grad()
+def extract_split(split, tokenizer, model, device, batch_size, max_length, data_dir, limit=None):
+    df = load_split(split, data_dir)
+    if limit:
+        df = df.head(limit)
+    texts = df["text_input"].tolist()
+
+    pooled = {how: [] for how in TEXT_FEATURES}
+    lengths = []
+    for start in tqdm(range(0, len(texts), batch_size), desc=f"{split:>10}"):
+        batch = texts[start:start + batch_size]
+        enc = tokenize(tokenizer, batch, max_length)
+        hidden = model(input_ids=enc["input_ids"].to(device),
+                       attention_mask=enc["attention_mask"].to(device)).last_hidden_state
+        mask = enc["attention_mask"].to(device)
+        for how in TEXT_FEATURES:
+            pooled[how].append(pool_text_features(hidden, mask, how).float().cpu())
+        # untruncated length (with [CLS]/[SEP]) to report how many captions lose tokens at 128
+        lengths += [len(ids) for ids in tokenizer(batch, truncation=False)["input_ids"]]
+
+    labels = torch.tensor(df["sarcasm_binary"].to_numpy(), dtype=torch.long)
+    lengths_t = torch.tensor(lengths, dtype=torch.float32)
+    stats = {
+        "no_text": int((df["text_input"] == NO_TEXT).sum()),
+        "truncated_at_max_length": int((lengths_t > max_length).sum()),
+        "tokens_mean": round(float(lengths_t.mean()), 2),
+        "tokens_median": float(lengths_t.median()),
+        "tokens_max": int(lengths_t.max()),
+    }
+    results = {how: {"sample_id": df["sample_id"].tolist(), "features": torch.cat(chunks),
+                     "labels": labels} for how, chunks in pooled.items()}
+    return results, stats
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--config", default="configs/multimodal_baseline.json")
+    ap.add_argument("--data_dir", default=None)
+    ap.add_argument("--model_dir", default=None,
+                    help="local copy of distilbert-base-uncased; default loads the pinned Hub revision")
+    ap.add_argument("--out_prefix", default=None,
+                    help="caches go to <out_prefix>_first_token and <out_prefix>_mean_pooling "
+                         "(must be new); default features/distilbert")
+    ap.add_argument("--splits", nargs="+", choices=SPLITS, default=list(SPLITS))
+    ap.add_argument("--batch_size", type=int, default=32)
+    ap.add_argument("--limit", type=int, default=None, help="only the first N rows (smoke test)")
+    args = ap.parse_args()
+    if args.batch_size <= 0 or (args.limit is not None and args.limit <= 0):
+        ap.error("batch_size and limit must be positive")
+    if len(set(args.splits)) != len(args.splits):
+        ap.error("splits must not contain duplicates")
+    prefix = args.out_prefix or "features/distilbert"
+    if args.limit is not None and args.out_prefix is None:
+        prefix += f"_smoke_{args.limit}"
+    out_dirs = {how: Path(f"{prefix}_{how}") for how in TEXT_FEATURES}
+    require_new_paths(*out_dirs.values())  # fail before loading DistilBERT
+
+    cfg = json.loads(Path(args.config).read_text(encoding="utf-8"))
+    set_seed(cfg["seed"])
+    device = get_device()
+    max_length = cfg["text_max_length"]
+    source = args.model_dir or f"{cfg['text_model_id']}@{cfg['text_revision']}"
+    print(f"device={device}  model={source}  max_length={max_length}")
+
+    tokenizer, model = load_text_encoder(cfg, device, args.model_dir)
+    weight_file, weight_hash = weights_sha256(args.model_dir) if args.model_dir else (None, None)
+    for out_dir in out_dirs.values():
+        out_dir.mkdir(parents=True, exist_ok=False)
+
+    base_meta = {
+        "text_model_id": cfg["text_model_id"],
+        "text_revision_requested": cfg["text_revision"],
+        "text_commit_resolved": getattr(model.config, "_commit_hash", None),
+        "text_weights_source": "local_dir" if args.model_dir else "hub",
+        "text_weights_file": weight_file,
+        "text_weights_sha256": weight_hash,
+        "tokenizer": type(tokenizer).__name__,
+        "do_lower_case": bool(getattr(tokenizer, "do_lower_case", True)),
+        "max_length": max_length,
+        "truncation": True,
+        "padding": "longest_in_batch",
+        "batch_size": args.batch_size,
+        "torch": torch.__version__,
+        "transformers": transformers.__version__,
+        "device": str(device),
+        "limit": args.limit,
+    }
+    metas = {how: {**base_meta, "text_feature": how, "splits": {}} for how in TEXT_FEATURES}
+    for split in args.splits:
+        t0 = time.time()
+        results, stats = extract_split(split, tokenizer, model, device, args.batch_size,
+                                       max_length, args.data_dir, args.limit)
+        secs = time.time() - t0
+        for how, res in results.items():
+            f = res["features"]
+            assert len(res["sample_id"]) == f.shape[0] == res["labels"].shape[0]
+            assert torch.isfinite(f).all(), f"{split}/{how}: NaN/inf in features"
+            path = out_dirs[how] / f"{split}.pt"
+            torch.save(res, path)
+            metas[how]["splits"][split] = {"n": f.shape[0], "dim": f.shape[1],
+                                           "seconds": round(secs, 1), "sha256": file_sha256(path),
+                                           **stats}
+            print(f"  saved {path}  shape={tuple(f.shape)}")
+        print(f"  {split}: {secs:.1f}s  {stats}")
+
+    for how, out_dir in out_dirs.items():
+        (out_dir / "meta.json").write_text(json.dumps(metas[how], indent=2), encoding="utf-8")
+    print("done. meta ->", ", ".join(str(d / "meta.json") for d in out_dirs.values()))
+
+
+if __name__ == "__main__":
+    main()
diff --git a/tests/test_multimodal_pipeline.py b/tests/test_multimodal_pipeline.py
new file mode 100644
index 0000000..b90c9cd
--- /dev/null
+++ b/tests/test_multimodal_pipeline.py
@@ -0,0 +1,211 @@
+"""Tests for the DistilBERT text cache and the multimodal fusion pipeline (no encoder download).
+
+Run from the repository root with MEMOTION_DATA_DIR pointing at the fixed dataset:
+    python -m unittest discover -s tests -v
+"""
+import copy
+import json
+from pathlib import Path
+import subprocess
+import sys
+import tempfile
+import unittest
+from types import SimpleNamespace
+from unittest.mock import patch
+
+import torch
+import torch.nn.functional as F
+
+from src.common.data import load_split
+from src.common.labels import EXPECTED_SPLIT_SIZES
+from src.image.cache import file_sha256
+from src.multimodal.features import align_by_sample_id, load_split_features
+from src.multimodal.model import (FusionHead, build_fusion_head, build_fusion_mlp,
+                                  load_fusion_head)
+from src.text.cache import load_text_features
+from src.text.encoder import pool_text_features
+
+ROOT = Path(__file__).resolve().parents[1]
+CFG = json.loads((ROOT / "configs/multimodal_baseline.json").read_text(encoding="utf-8"))
+
+
+def text_meta(splits, **changes):
+    meta = dict(text_model_id=CFG["text_model_id"], text_revision_requested=CFG["text_revision"],
+                text_feature=CFG["text_feature"], max_length=CFG["text_max_length"], limit=None,
+                splits={s: {"n": EXPECTED_SPLIT_SIZES[s], "dim": 768} for s in splits})
+    meta.update(changes)
+    return meta
+
+
+def image_meta(splits):
+    return dict(clip_model_id=CFG["clip_model_id"], clip_revision_requested=CFG["clip_revision"],
+                feature=CFG["image_feature"], limit=None,
+                splits={s: {"n": EXPECTED_SPLIT_SIZES[s], "dim": 768} for s in splits})
+
+
+def write_cache(directory, split, features, meta, order=None):
+    truth = load_split(split)
+    ids = truth.sample_id.tolist()
+    labels = torch.tensor(truth.sarcasm_binary.to_numpy(), dtype=torch.long)
+    if order is not None:
+        ids, labels, features = [ids[i] for i in order], labels[order], features[order]
+    directory.mkdir(parents=True, exist_ok=True)
+    torch.save(dict(sample_id=ids, features=features, labels=labels), directory / f"{split}.pt")
+    meta["splits"][split]["sha256"] = file_sha256(directory / f"{split}.pt")
+    (directory / "meta.json").write_text(json.dumps(meta), encoding="utf-8")
+
+
+class MultimodalPipelineTests(unittest.TestCase):
+    def setUp(self):
+        self.temp = tempfile.TemporaryDirectory(prefix="multimodal_pipeline_")
+        self.work = Path(self.temp.name).resolve()
+        self.addCleanup(self.temp.cleanup)
+
+    def test_text_cache_accepts_complete_and_rejects_wrong_provenance(self):
+        directory = self.work / "text"
+        n = EXPECTED_SPLIT_SIZES["validation"]
+        write_cache(directory, "validation", torch.randn(n, 768), text_meta(["validation"]))
+        ids, x, y = load_text_features(directory, "validation", CFG)
+        self.assertEqual(ids, load_split("validation").sample_id.tolist())
+        self.assertEqual(tuple(x.shape), (n, 768))
+        for key, value in (("limit", 64), ("text_feature", "mean_pooling"), ("max_length", 512),
+                           ("text_model_id", "bert-base-uncased")):
+            with self.subTest(key=key):
+                write_cache(directory, "validation", torch.randn(n, 768),
+                            text_meta(["validation"], **{key: value}))
+                with self.assertRaises(ValueError):
+                    load_text_features(directory, "validation", CFG)
+
+    def test_text_cache_rejects_shuffled_rows_and_changed_values(self):
+        directory = self.work / "text"
+        n = EXPECTED_SPLIT_SIZES["validation"]
+        order = torch.randperm(n, generator=torch.Generator().manual_seed(0))
+        write_cache(directory, "validation", torch.randn(n, 768), text_meta(["validation"]), order)
+        with self.assertRaisesRegex(ValueError, "order"):
+            load_text_features(directory, "validation", CFG)
+        write_cache(directory, "validation", torch.randn(n, 768), text_meta(["validation"]))
+        cached = torch.load(directory / "validation.pt", weights_only=True)
+        cached["features"][0, 0] += 1
+        torch.save(cached, directory / "validation.pt")
+        with self.assertRaisesRegex(ValueError, "SHA-256"):
+            load_text_features(directory, "validation", CFG)
+
+    def test_alignment_uses_sample_id_not_row_number(self):
+        ids = ["a", "b", "c"]
+        x = torch.tensor([[1.0], [2.0], [3.0]])
+        y = torch.tensor([0, 1, 1])
+        x2, y2 = align_by_sample_id(["c", "a", "b"], x[[2, 0, 1]], y[[2, 0, 1]], ids)
+        self.assertTrue(torch.equal(x2, x))
+        self.assertTrue(torch.equal(y2, y))
+        with self.assertRaises(ValueError):
+            align_by_sample_id(["a", "b", "d"], x, y, ids)
+
+    def test_joint_loader_aligns_text_and_image(self):
+        n = EXPECTED_SPLIT_SIZES["validation"]
+        text, image = torch.randn(n, 768), torch.randn(n, 768)
+        write_cache(self.work / "text", "validation", text, text_meta(["validation"]))
+        write_cache(self.work / "image", "validation", image, image_meta(["validation"]))
+        ids, feats, y = load_split_features(CFG, "validation", self.work / "text",
+                                            self.work / "image")
+        self.assertEqual(ids, load_split("validation").sample_id.tolist())
+        self.assertTrue(torch.equal(feats["text"], text))
+        self.assertTrue(torch.equal(feats["image"], image))
+
+    def test_fusion_head_normalizes_then_concatenates_text_first(self):
+        head = build_fusion_head(CFG)
+        self.assertEqual(head.input_dim, 1536)
+        text, image = torch.randn(5, 768) * 7, torch.randn(5, 768) * 0.1
+        fused = head.fuse(text, image)
+        self.assertTrue(torch.allclose(fused, torch.cat([F.normalize(text, dim=-1),
