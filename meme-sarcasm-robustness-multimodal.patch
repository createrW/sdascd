diff --git a/scripts/check_tf32_emulation.py b/scripts/check_tf32_emulation.py
new file mode 100644
index 0000000..55b4f6d
--- /dev/null
+++ b/scripts/check_tf32_emulation.py
@@ -0,0 +1,90 @@
+"""Check that TF32 explains the gap between CPU and image-group CUDA CLIP features.
+
+PyTorch enables TF32 for CUDA convolutions by default (torch.backends.cudnn.allow_tf32 = True).
+This script recomputes CLIP pooler_output on CPU twice — in float32, and with the patch-embedding
+convolution's inputs and weights rounded to TF32 (10-bit mantissa) — and compares both with the
+image group's CUDA cache.
+
+    python -m scripts.check_tf32_emulation --clip_model_dir hf_local/clip-vit-base-patch32 \
+        --out Team_Review/multimodal/report/tf32_emulation.json
+"""
+import argparse
+import json
+import sys
+from pathlib import Path
+
+import torch
+import torch.nn.functional as F
+from transformers import AutoImageProcessor, CLIPModel
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
+
+from src.common.data import load_image, load_split  # noqa: E402
+
+
+def round_to_tf32(t):
+    """Round float32 to the nearest value with a 10-bit mantissa (TF32)."""
+    i = t.float().contiguous().view(torch.int32)
+    return ((i + 0x1000) & ~0x1FFF).view(torch.float32)
+
+
+@torch.no_grad()
+def features(model, pixels, tf32):
+    conv = model.vision_model.embeddings.patch_embedding
+    weight = conv.weight.data.clone()
+    if tf32:
+        conv.weight.data = round_to_tf32(weight)
+        pixels = round_to_tf32(pixels)
+    try:
+        return model.vision_model(pixel_values=pixels).pooler_output
+    finally:
+        conv.weight.data = weight
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--clip_model_dir", default=None, help="default: the pinned Hub revision")
+    ap.add_argument("--reference_dir", default="features/20261006_code_fixes_validation_v2")
+    ap.add_argument("--n_first", type=int, default=64)
+    ap.add_argument("--n_worst", type=int, default=10)
+    ap.add_argument("--data_dir", default=None)
+    ap.add_argument("--out", default=None)
+    args = ap.parse_args()
+
+    source = args.clip_model_dir or "openai/clip-vit-base-patch32"
+    kwargs = {} if args.clip_model_dir else {"revision": "3d74acf"}
+    model = CLIPModel.from_pretrained(source, **kwargs).eval()
+    processor = AutoImageProcessor.from_pretrained(source, **kwargs)
+    report = {"clip_source": str(source), "groups": {}}
+
+    for split in ("validation", "train"):
+        ref = torch.load(Path(args.reference_dir) / f"{split}.pt", weights_only=True)
+        cpu = torch.load(Path("features/clip_vitb32_pooler_cpu") / f"{split}.pt", weights_only=True)
+        assert ref["sample_id"] == cpu["sample_id"]
+        cos = F.cosine_similarity(ref["features"].double(), cpu["features"].double())
+        frame = load_split(split, args.data_dir)
+        groups = {f"{split}_worst{args.n_worst}": torch.argsort(cos)[:args.n_worst].tolist()}
+        if split == "validation":
+            groups[f"validation_first{args.n_first}"] = list(range(args.n_first))
+        for name, rows in groups.items():
+            images = [load_image(frame.image_abspath[i]) for i in rows]
+            pixels = processor(images=images, return_tensors="pt")["pixel_values"]
+            r = ref["features"][rows]
+            out = {}
+            for mode in ("float32", "tf32_conv"):
+                f = features(model, pixels, tf32=(mode == "tf32_conv"))
+                c = F.cosine_similarity(f.double(), r.double())
+                out[mode] = {"mean_abs_diff": float((f - r).abs().mean()),
+                             "max_abs_diff": float((f - r).abs().max()),
+                             "min_cosine": float(c.min()), "mean_cosine": float(c.mean())}
+            report["groups"][name] = {"n": len(rows), "sample_ids": [frame.sample_id[i] for i in rows],
+                                      **out}
+            print(f"{name:22s} float32 mean|d| {out['float32']['mean_abs_diff']:.2e} "
+                  f"min cos {out['float32']['min_cosine']:.5f}  ->  TF32 conv mean|d| "
+                  f"{out['tf32_conv']['mean_abs_diff']:.2e} min cos {out['tf32_conv']['min_cosine']:.6f}")
+    if args.out:
+        Path(args.out).write_text(json.dumps(report, indent=2), encoding="utf-8")
+
+
+if __name__ == "__main__":
+    main()
diff --git a/scripts/compare_feature_caches.py b/scripts/compare_feature_caches.py
new file mode 100644
index 0000000..079f890
--- /dev/null
+++ b/scripts/compare_feature_caches.py
@@ -0,0 +1,56 @@
+"""Compare two feature caches of the same split row by row (same sample IDs, same order).
+
+Used to check that features extracted on another machine (or from a local copy of the pinned
+weights) match a reference cache, e.g. CPU vs the image group's CUDA cache:
+
+    python -m scripts.compare_feature_caches features/20261006_code_fixes_validation_v2 \
+        features/clip_vitb32_pooler_cpu --splits train validation
+
+Prints max/mean absolute difference and the minimum cosine similarity per split; exits nonzero
+if sample IDs, labels or shapes differ, or if the minimum cosine is below --min_cosine.
+"""
+import argparse
+import sys
+from pathlib import Path
+
+import torch
+import torch.nn.functional as F
+
+
+def compare(reference_dir, candidate_dir, split):
+    ref = torch.load(Path(reference_dir) / f"{split}.pt", map_location="cpu", weights_only=True)
+    cand = torch.load(Path(candidate_dir) / f"{split}.pt", map_location="cpu", weights_only=True)
+    if ref["sample_id"] != cand["sample_id"]:
+        raise ValueError(f"{split}: sample IDs or order differ")
+    if not torch.equal(ref["labels"], cand["labels"]):
+        raise ValueError(f"{split}: labels differ")
+    a, b = ref["features"].float(), cand["features"].float()
+    if a.shape != b.shape:
+        raise ValueError(f"{split}: shapes {tuple(a.shape)} vs {tuple(b.shape)}")
+    diff = (a - b).abs()
+    cos = F.cosine_similarity(a, b, dim=1)
+    return {"n": a.shape[0], "max_abs": diff.max().item(), "mean_abs": diff.mean().item(),
+            "mean_abs_reference": a.abs().mean().item(), "min_cosine": cos.min().item(),
+            "mean_cosine": cos.mean().item()}
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("reference_dir")
+    ap.add_argument("candidate_dir")
+    ap.add_argument("--splits", nargs="+", default=["train", "validation"])
+    ap.add_argument("--min_cosine", type=float, default=0.999)
+    args = ap.parse_args()
+    ok = True
+    for split in args.splits:
+        r = compare(args.reference_dir, args.candidate_dir, split)
+        print(f"{split}: n={r['n']}  max_abs={r['max_abs']:.3e}  mean_abs={r['mean_abs']:.3e} "
+              f"(reference mean |x| {r['mean_abs_reference']:.3f})  "
+              f"min_cos={r['min_cosine']:.6f}  mean_cos={r['mean_cosine']:.6f}")
+        ok &= r["min_cosine"] >= args.min_cosine
+    print("FEATURES MATCH" if ok else "FEATURES DIFFER")
+    return 0 if ok else 1
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/scripts/convert_openai_clip_to_hf.py b/scripts/convert_openai_clip_to_hf.py
